# Algorithm Lens Environment Variables

# =============================================================================
# Email Gate Configuration
# =============================================================================

# Disable email gate for local development/testing
# Set to 'true' to skip the email collection modal
# VITE_DISABLE_EMAIL_GATE=true

# =============================================================================
# Beehiiv Integration (Optional)
# =============================================================================

# Beehiiv embed form action URL
# If both VITE_BEEHIIV_EMBED_ACTION and VITE_BEEHIIV_PUBLICATION_ID are set,
# emails will be submitted to Beehiiv. Otherwise, emails are stored locally only.
#
# Example: https://embeds.beehiiv.com/abc123def
# VITE_BEEHIIV_EMBED_ACTION=

# Beehiiv publication ID
# Required when using Beehiiv integration
# VITE_BEEHIIV_PUBLICATION_ID=

# =============================================================================
# Notes
# =============================================================================
#
# 1. Local-only mode (default):
#    - Don't set VITE_BEEHIIV_* variables
#    - Emails are stored in localStorage only
#    - No network requests are made
#
# 2. Beehiiv mode:
#    - Set both VITE_BEEHIIV_EMBED_ACTION and VITE_BEEHIIV_PUBLICATION_ID
#    - Emails are submitted to Beehiiv
#    - Falls back to local-only if submission fails
#
# 3. Development mode:
#    - Set VITE_DISABLE_EMAIL_GATE=true to skip email collection entirely
#    - Useful for testing and development

# AlgorithmLens Environment Variables
# Copy this file to .env.local and fill in your actual values for local development

# Database Configuration
# For production, set DATABASE_URL to your Supabase PostgreSQL connection string
# For local development, omit this to use SQLite (scans.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase Configuration
SUPABASE_JWT_SECRET=your-jwt-secret-here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your-key-here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_ANNUAL=price_your-annual-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Gemini Configuration (AI Analysis)
GEMINI_API_KEY=your-gemini-api-key

# Beehiiv Configuration (Waitlist/Newsletter)
BEEHIIV_API_KEY=your-beehiiv-api-key
BEEHIIV_PUBLICATION_ID=your-publication-id

# Application Configuration
VITE_ALG_API_BASE_URL=http://localhost:8000
VITE_COMING_SOON_MODE=false
ENV=development
TRIAL_PERIOD_DAYS=14

# Optional: Sentry Configuration (Error Tracking)
# VITE_SENTRY_DSN=your-sentry-dsn-here
# VITE_SENTRY_ENVIRONMENT=development

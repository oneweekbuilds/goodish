{
  "metadata": {
    "version": "1.0",
    "lastUpdated": "2026-02-24",
    "purpose": "Machine-readable design tokens for AlgorithmLens web platform"
  },
  "colors": {
    "brand": {
      "primaryBlue": "#2563EB",
      "accentGreen": "#10B981"
    },
    "backgrounds": {
      "pageBackground": "#F7F8FC",
      "surfaceDefault": "#FFFFFF"
    },
    "text": {
      "textMain": "#1E293B",
      "textMuted": "#4B5563"
    },
    "borders": {
      "borderLight": "rgba(30, 41, 59, 0.08)"
    },
    "status": {
      "success": "#059669",
      "error": "#DC2626",
      "warning": "#D97706"
    },
    "emotionalTone": {
      "positive": "#93C5B8",
      "neutral": "#CBD5E1",
      "negative": "#A3B1C6"
    },
    "palette": {
      "blue": {
        "50": "#EFF6FF",
        "100": "#DBEAFE",
        "200": "#BFDBFE",
        "600": "#2563EB",
        "700": "#1D4ED8",
        "800": "#1E40AF"
      },
      "green": {
        "50": "#ECFDF5",
        "100": "#D1FAE5",
        "200": "#A7F3D0",
        "500": "#10B981",
        "600": "#059669",
        "700": "#047857"
      },
      "slate": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A"
      }
    },
    "scrollbar": {
      "thumb": "#CBD5E1",
      "thumbHover": "#94A3B8",
      "track": "transparent"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', 'Plus Jakarta Sans', 'sans-serif'"
    },
    "fontSizes": {
      "heroHeadline": "clamp(1.625rem, 4.5vw, 2.25rem)",
      "tabLabel": {
        "mobile": "11px",
        "desktop": "14px"
      },
      "kicker": "11px",
      "metaPill": "11px",
      "bodyText": "15px",
      "smallText": "12px-14px"
    },
    "fontWeights": {
      "bold": 700,
      "semibold": 600,
      "medium": 500,
      "regular": 400
    },
    "lineHeights": {
      "heroHeadline": 1.25,
      "bodyText": 1.65
    },
    "letterSpacing": {
      "tightHero": "-0.03em",
      "tightHeading": "-0.02em",
      "tightCard": "-0.01em",
      "wideLabel": "0.05em",
      "widerLabel": "0.1em"
    }
  },
  "spacing": {
    "padding": {
      "heroCard": {
        "vertical": "clamp(2rem, 5vw, 3.5rem)",
        "horizontal": "clamp(1.75rem, 4vw, 3rem)"
      },
      "metaPill": "0.375rem 0.875rem",
      "buttonDisclosure": "0.5rem 1rem"
    },
    "margins": {
      "heroMarginBottom": "40px",
      "featureMomentMarginBottom": {
        "sm": "48px",
        "md": "64px",
        "lg": "80px"
      },
      "tabContainerMarginBottom": {
        "algorithmTab": "24px",
        "otherTabs": "40px"
      }
    },
    "gaps": {
      "tabNavigation": "gap-1.5",
      "buttonContent": "gap-1.5 sm:gap-2",
      "cardHeader": "gap-3",
      "standard": ["gap-2", "gap-3", "gap-4", "gap-5"]
    },
    "negativeMargins": {
      "featureMoment": ["-mx-2", "sm:-mx-4", "md:-mx-8"]
    }
  },
  "borderRadius": {
    "radiusSm": "12px",
    "radiusMd": "20px",
    "radiusLg": "28px",
    "pill": "9999px",
    "tabNavigationContainer": "16px",
    "tabButtons": "12px",
    "heroCard": "24px",
    "metaPill": "9999px"
  },
  "shadows": {
    "soft": "0 2px 8px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02)",
    "medium": "0 8px 24px rgba(15, 23, 42, 0.06), 0 2px 8px rgba(15, 23, 42, 0.03)",
    "strong": "0 20px 60px rgba(15, 23, 42, 0.12), 0 4px 16px rgba(15, 23, 42, 0.04)",
    "glow": "0 0 20px rgba(37, 99, 235, 0.25), 0 0 6px rgba(37, 99, 235, 0.1)",
    "card": "0 1px 3px rgba(0, 0, 0, 0.04), 0 4px 16px rgba(15, 23, 42, 0.04)",
    "cardHover": "0 4px 12px rgba(0, 0, 0, 0.06), 0 8px 32px rgba(15, 23, 42, 0.06)",
    "hero": "0 8px 40px rgba(37, 99, 235, 0.1), 0 2px 8px rgba(37, 99, 235, 0.04)",
    "tabNavInset": "inset 0 1px 2px rgba(0, 0, 0, 0.03)",
    "tabButtonActive": "0 2px 8px {accentColor}30, 0 1px 3px rgba(0,0,0,0.06)",
    "heroCardCustom": "0 1px 3px rgba(0,0,0,0.04), 0 8px 40px rgba(37, 99, 235, 0.08)"
  },
  "dashboard": {
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "accent": "#2563EB"
      },
      {
        "id": "sources",
        "label": "Who Shapes Your Feed",
        "accent": "#6366F1"
      },
      {
        "id": "ads",
        "label": "Ads & Promotions",
        "accent": "#D97706"
      },
      {
        "id": "politics",
        "label": "Political Exposure",
        "accent": "#7C3AED"
      },
      {
        "id": "tone",
        "label": "Emotional Tone",
        "accent": "#0D9488"
      },
      {
        "id": "suggested_vs_followed",
        "label": "Suggested vs. Followed",
        "accent": "#E11D48"
      }
    ],
    "tabNavigation": {
      "container": {
        "background": "linear-gradient(180deg, rgba(241, 245, 249, 0.8) 0%, rgba(248, 250, 252, 0.9) 100%)",
        "border": "1px solid rgba(226, 232, 240, 0.6)",
        "shadow": "inset 0 1px 2px rgba(0, 0, 0, 0.03)",
        "borderRadius": "16px"
      },
      "button": {
        "inactive": {
          "textColor": "#4B5563",
          "background": "transparent",
          "hoverBackground": "rgba(255, 255, 255, 0.7)",
          "hoverTextColor": "#1E293B"
        },
        "active": {
          "textColor": "#FFFFFF",
          "backgroundGradient": "linear-gradient(135deg, {accentColor} 0%, {accentColor}DD 100%)",
          "shadow": "0 2px 8px {accentColor}30, 0 1px 3px rgba(0,0,0,0.06)",
          "letterSpacing": "-0.01em"
        },
        "sizing": {
          "padding": "px-3 sm:px-5 py-2.5",
          "fontSize": "text-[11px] sm:text-sm",
          "fontWeight": "semibold",
          "borderRadius": "12px",
          "minHeight": "40px"
        },
        "focus": {
          "ring": "focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-blue/40 focus-visible:ring-offset-1"
        }
      }
    }
  },
  "heroCard": {
    "main": {
      "background": "linear-gradient(135deg, #FFFFFF 0%, #F0F5FF 40%, #EFF6FF 70%, #F0F5FF 100%)",
      "border": "1px solid rgba(37, 99, 235, 0.15)",
      "padding": "clamp(2rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 3rem)",
      "borderRadius": "24px",
      "shadow": "0 1px 3px rgba(0,0,0,0.04), 0 8px 40px rgba(37, 99, 235, 0.08)",
      "transition": "duration-300",
      "hoverShadow": "hover:shadow-lg"
    },
    "kicker": {
      "fontSize": "11px",
      "color": "#64748B",
      "letterSpacing": "0.04em or 0.14em",
      "fontWeight": "500",
      "textTransform": "conditional uppercase"
    },
    "metaPill": {
      "background": "rgba(255, 255, 255, 0.7)",
      "border": "1px solid rgba(37, 99, 235, 0.2)",
      "padding": "0.375rem 0.875rem",
      "fontSize": "11px",
      "color": "#64748B",
      "fontWeight": "500",
      "borderRadius": "9999px",
      "iconSize": "12px",
      "iconColor": "text-slate-400"
    },
    "headline": {
      "fontFamily": "system-ui",
      "fontWeight": "700",
      "fontSize": "clamp(1.625rem, 4.5vw, 2.25rem)",
      "lineHeight": "1.25",
      "letterSpacing": "-0.025em",
      "maxWidth": "100%",
      "color": "text-slate-800",
      "marginLeft": "-1rem",
      "paddingLeft": "1rem"
    },
    "accentBar": {
      "width": "6px",
      "background": "linear-gradient(180deg, #2563EB 0%, #60A5FA 100%)",
      "borderRadius": "rounded-r-lg"
    },
    "disclosureButton": {
      "background": "rgba(37, 99, 235, 0.06)",
      "border": "1px solid rgba(37, 99, 235, 0.12)",
      "color": "rgba(37, 99, 235, 0.85)",
      "padding": "0.5rem 1rem",
      "borderRadius": "9999px",
      "hoverBackground": "hover:bg-blue-100",
      "fontSize": "text-sm",
      "fontWeight": "font-medium",
      "transition": "transition-all"
    },
    "evidence": {
      "background": "linear-gradient(180deg, rgba(37, 99, 235, 0.04) 0%, rgba(248, 250, 252, 0.85) 100%)",
      "border": "1px solid rgba(37, 99, 235, 0.10)",
      "padding": "1.25rem",
      "borderRadius": "24px",
      "marginTop": "1.5rem"
    },
    "featureMoment": {
      "background": "linear-gradient(180deg, #FFFFFF 0%, rgba(239, 246, 255, 0.5) 40%, rgba(239, 246, 255, 0.3) 70%, #FFFFFF 100%)",
      "borderRadius": "24px",
      "border": "1px solid rgba(37, 99, 235, 0.08)",
      "shadow": "0 1px 3px rgba(0,0,0,0.03), 0 8px 40px rgba(37, 99, 235, 0.05)",
      "marginTop": "2rem",
      "padding": "clamp(2rem, 5vw, 3.5rem) clamp(2rem, 5vw, 3rem)",
      "negativeMargins": ["-mx-2", "sm:-mx-4", "md:-mx-8"]
    }
  },
  "accessibility": {
    "reducedMotion": {
      "scrollBehavior": "auto",
      "animationDuration": "0.01ms",
      "animationIterationCount": "1",
      "transitionDuration": "0.01ms"
    },
    "tabsWAIARIA": {
      "role": "tablist, tab, tabpanel",
      "focus": "focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-blue/40 focus-visible:ring-offset-1",
      "attributes": [
        "aria-selected",
        "aria-controls",
        "aria-label",
        "tabIndex"
      ]
    }
  },
  "responsive": {
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "fluidPatterns": {
      "heroFontSize": "clamp(1.625rem, 4.5vw, 2.25rem)",
      "heroPadding": "clamp(2rem, 5vw, 3.5rem)"
    }
  },
  "animations": {
    "custom": {
      "pulseSlow": "pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite",
      "scrollSlow": "scroll 40s linear infinite"
    },
    "keyframes": {
      "scroll": {
        "0%": "translateX(0)",
        "100%": "translateX(-50%)"
      }
    },
    "chevronRotation": {
      "closed": "rotate(0deg)",
      "open": "rotate(180deg)",
      "transition": "transition-transform"
    }
  }
}

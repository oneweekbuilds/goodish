# AlgorithmLens Mobile App — Environment Variables
# Copy this to .env and fill in your values.

# Supabase (same credentials as your web app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API
EXPO_PUBLIC_API_BASE_URL=https://your-backend-url.com

# Gemini 2.0 Flash (for broadcast analysis)
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# Sentry (error tracking — optional in development)
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/0
